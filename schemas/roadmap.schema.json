{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neurotech-roadmaps:schema:roadmap",
  "title": "Roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "audience",
    "prerequisites",
    "destination_outcomes",
    "estimated_hours",
    "core_path"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "audience": {
      "type": "string",
      "minLength": 20
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "destination_outcomes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 15
      }
    },
    "estimated_hours": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "core_path": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "optional_branches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "papers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "starting_assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "minimum_viable_path": {
      "type": "string",
      "minLength": 30
    },
    "deeper_path": {
      "type": "string",
      "minLength": 30
    },
    "common_misconceptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "typical_failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "safety": {
      "type": "string",
      "minLength": 10
    },
    "ethics": {
      "type": "string",
      "minLength": 10
    },
    "research_directions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "next_steps": {
      "type": "string",
      "minLength": 10
    }
  }
}
