{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neurotech-roadmaps:schema:node",
  "title": "Learning node",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "domain",
    "level",
    "description",
    "learning_objectives",
    "prerequisites"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "domain": {
      "type": "string",
      "minLength": 2
    },
    "level": {
      "enum": [
        "foundation",
        "intermediate",
        "advanced",
        "research"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "estimated_hours": {
      "type": "string",
      "minLength": 3
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "exercise": {
      "type": "string",
      "minLength": 10
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "common_misconceptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "safety": {
      "type": "string",
      "minLength": 10
    },
    "ethics": {
      "type": "string",
      "minLength": 10
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
